      "source": [
        "# 上辺の長さ\n",
        "top_edge = 10\n",
        "# 下辺の長さ\n",
        "bottom_edge = 20\n",
        "# 高さ\n",
        "height = 5\n",
        "# 台形の面積を変数に代入\n",
        "area_of_trapezoid = (top_edge + bottom_edge) * height / 2\n",
        "\n",
        "# 台形の面積を出力\n",
        "print(f\"{area_of_trapezoid}㎠\")"
      ]
